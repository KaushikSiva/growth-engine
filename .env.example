# Public application URLs
APP_BASE_URL=http://localhost:3001
PRODUCT_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
COMPANY_API_URL=http://localhost:8000

# Supabase managed Postgres is the production system of record.
# Render: use the Supavisor SESSION pooler URL on port 5432.
# Migrations: use the direct URL when IPv6 is available, otherwise the same
# session-pooler URL. Passwords must be URL encoded.
# Example session pooler:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=
# Example direct migration URL:
# postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_MIGRATION_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Optional SQLite fallback for local development/tests only. It is ignored when
# SUPABASE_DATABASE_URL is set.
DATABASE_URL=sqlite:///./reproclip_company.db

# Required before founder actions are enabled
FOUNDER_APPROVAL_TOKEN=

# Stripe $5 voluntary support
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Pioneer CEO
PIONEER_API_KEY=
PIONEER_MODEL=Qwen/Qwen3-8B
PIONEER_BASE_URL=https://api.pioneer.ai/v1

# Terac real human workforce
TERAC_API_KEY=
TERAC_MCP_URL=https://terac.com/api/mcp
TERAC_PROJECT_ID=
TERAC_BUDGET_USD=0

# Optional Linq founder notifications
LINQ_API_KEY=
LINQ_FROM_NUMBER=
LINQ_TO_NUMBER=

# Optional sponsor and operations integrations
SUPERSERVE_API_KEY=
REPLAY_PROJECT_URL=
INFRASTRUCTURE_COST_USD=
BAND_API_KEY=
RENDER_API_KEY=
